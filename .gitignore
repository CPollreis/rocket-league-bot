.venv/
__pycache__/
.claude/

# local copy of the rlviser viewer binary, for RL_RENDER=1 (see README)
rlviser
rlviser.exe
rlviser.disabled
# custom from-source Windows build with the WSAECONNRESET fix (see
# scripts/launch_rlviser_windows.ps1) -- plus its dynamic_linking-feature
# side-car DLLs, which must ship next to it
rlviser_windows_fixed.exe
bevy_dylib-*.dll
std-*.dll

# rlviser writes its own settings file into the working directory
settings.txt

# regenerated from the script on every run (force_overwrite=True)
config.json

# rlgym-learn shared-memory scratch dir (flinks_folder in config.json)
shmem_flinks/

# wandb: keep the folder tracked, ignore all run data and logs
wandb/*
!wandb/.gitkeep

# checkpoints: keep the folder tracked, ignore all generated runs / logs / weights
agent_controller_checkpoints/*
!agent_controller_checkpoints/.gitkeep

# smoke tests
smoke_test*
*_smoke_test*
smoke-test*
*_smoke_test.py
**/smoke_test/
